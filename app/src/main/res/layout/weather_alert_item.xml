<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/alert_item_background"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/alertSeverity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/severity_badge_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="8dp"
            tools:text="SEVERE" />

        <TextView
            android:id="@+id/alertEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FF6F00"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            tools:text="Thunderstorm Warning" />

    </LinearLayout>

    <TextView
        android:id="@+id/alertDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E65100"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp"
        tools:text="Severe thunderstorms with heavy rain and strong winds expected." />

    <TextView
        android:id="@+id/alertTiming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF8F00"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        tools:text="Until 6:00 PM today" />

</LinearLayout>