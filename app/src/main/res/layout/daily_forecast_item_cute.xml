<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/daily_item_background">

    <TextView
        android:id="@+id/dayTextView"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary_cute"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        tools:text="Today" />

    <ImageView
        android:id="@+id/weatherIconImageView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/weather_sunny_cute"
        tools:src="@drawable/weather_sunny_cute" />

    <TextView
        android:id="@+id/precipitationText"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/primary_cute"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        tools:text="60%" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/lowTempTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary_cute"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="8dp"
        tools:text="15°" />

    <TextView
        android:id="@+id/highTempTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary_cute"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        tools:text="28°" />

</LinearLayout>